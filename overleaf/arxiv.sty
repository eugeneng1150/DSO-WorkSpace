% arxiv.sty - Style file for arXiv preprints
% Based on NIPS/NeurIPS style with modifications for arXiv

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{arxiv}[2024/01/01 arXiv preprint style]

% Page layout
\usepackage[margin=1in]{geometry}
\usepackage{setspace}

% Fonts
\usepackage{times}

% Line spacing
\setstretch{1.1}

% Section formatting
\usepackage{titlesec}
\titleformat{\section}{\large\bfseries}{\thesection}{1em}{}
\titleformat{\subsection}{\normalsize\bfseries}{\thesubsection}{1em}{}
\titleformat{\subsubsection}{\normalsize\itshape}{\thesubsubsection}{1em}{}

% Abstract formatting
\renewenvironment{abstract}%
{\centerline{\large\bfseries Abstract}\vspace{0.5ex}\begin{quote}\small}%
{\par\end{quote}\vspace{1ex}}

% Clean page style — page numbers only
\usepackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\rhead{\small\thepage}
\renewcommand{\headrulewidth}{0pt}
\fancypagestyle{plain}{\fancyhf{}\rhead{\small\thepage}\renewcommand{\headrulewidth}{0pt}}

% Paragraph spacing
\setlength{\parskip}{0.5ex plus 0.2ex minus 0.1ex}
\setlength{\parindent}{1.5em}

% Compact lists — enumitem loaded in main.tex before \setlist is called

% Float placement
\renewcommand{\floatpagefraction}{0.8}
\renewcommand{\topfraction}{0.9}
\renewcommand{\bottomfraction}{0.8}
\renewcommand{\textfraction}{0.1}
